# Caddy da VPS (27/09/2026): certificado HTTPS automático (Let's Encrypt) para
# cada nome. No Cloudflare os registros ficam "DNS only" (nuvem cinza): o IP
# real do visitante chega à API (limite da inscrição pública por IP) e o
# certificado sai direto para a VPS.
{
	email contato@servirea.com.br
}

(seguranca) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
}

(spa) {
	encode zstd gzip
	try_files {path} /index.html
	file_server
	@hash path *.js *.css *.woff2
	@resto not path *.js *.css *.woff2
	header @hash Cache-Control "public, max-age=31536000, immutable"
	header @resto Cache-Control "no-cache"
}

servirea.com.br, www.servirea.com.br {
	redir https://app.servirea.com.br{uri} permanent
}

app.servirea.com.br {
	import seguranca
	# CSP do HTML. Não entra no snippet compartilhado: a API é JSON e o
	# painel do WhatsApp (Evolution) quebraria com esta política.
	# connect-src ainda lista o host antigo da API para quem não atualizou o front.
	header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://api.servirea.com.br https://viacep.com.br https://challenges.cloudflare.com https://qcybebkhwhrudbwoweip.supabase.co; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:"
	handle /api/* {
        # Preserva os uploads de até 6 MiB; a integração também limita a leitura na API.
        request_body {
            max_size 6MiB
        }
		uri strip_prefix /api
		reverse_proxy servirea-api:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		root * /srv/servirea
		import spa
	}
}

# O proxy sobrescreve o X-Forwarded-For com o IP de quem conectou (não
# repassa o que o navegador mandou) — README do servirea-api-back.
api.servirea.com.br {
    request_body {
        max_size 6MiB
    }
	import seguranca
	encode zstd gzip
	reverse_proxy servirea-api:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}

central.servirea.com.br {
	import seguranca
	header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://api-central.servirea.com.br https://viacep.com.br; frame-src 'none'; worker-src 'self' blob:"
	handle /api/* {
        # Preserva os uploads de até 6 MiB; a integração também limita a leitura na API.
        request_body {
            max_size 6MiB
        }
		uri strip_prefix /api
		reverse_proxy central-api:8081 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		root * /srv/central
		import spa
	}
}

api-central.servirea.com.br {
    request_body {
        max_size 6MiB
    }
	import seguranca
	encode zstd gzip
	reverse_proxy central-api:8081 {
		header_up X-Forwarded-For {remote_host}
	}
}

# WhatsApp (EvolutionGo): só para ler o QR code e administrar a conexão. Duas travas: usuário e senha aqui
# (caddy.env na VPS) e a chave global da API na tela da Evolution. A Central usa a rede interna.
whatsapp.servirea.com.br {
	import seguranca
	basic_auth {
		{$EVO_ADMIN_USUARIO} {$EVO_ADMIN_HASH}
	}
	reverse_proxy evolution:4000
}
