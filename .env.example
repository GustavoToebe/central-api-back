DB_URL
DB_USER
DB_PASSWORD
CENTRAL_JWT_SEGREDO
CORS_ALLOWED_ORIGINS
CENTRAL_CSRF_COOKIE_DOMAIN
CENTRAL_OPERADOR_SEED_EMAIL
CENTRAL_OPERADOR_SEED_SENHA
# Entrada: id:segredoBase64:produto, separados por vírgula; legado sem produto só SERVIREA
CENTRAL_PRODUTO_SERVIRE_CHAVES_ENTRADA
CENTRAL_PRODUTO_SERVIRE_CHAVE_SAIDA_ID
CENTRAL_PRODUTO_SERVIRE_CHAVE_SAIDA_SEGREDO

# Mercado Pago: opcionais enquanto checkout estiver desativado; nunca inserir valores reais no Git.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
MP_RETORNO_URL=
MP_NOTIFICACAO_URL=
MP_PRODUCAO=false

# Login: limites por instância (não coordenados entre réplicas)
CENTRAL_AUTH_LIMITE_IP=60
CENTRAL_AUTH_LIMITE_CONTA=10
CENTRAL_AUTH_JANELA_SEGUNDOS=600
CENTRAL_AUTH_MAX_CHAVES=20000

# MFA: chaves próprias de AES-256 (id:base64, separadas por vírgula), nunca valores reais no Git.
# Sem configuração: login existente funciona, mas ativação MFA fica indisponível.
CENTRAL_MFA_CHAVES=
CENTRAL_MFA_CHAVE_ATIVA=
